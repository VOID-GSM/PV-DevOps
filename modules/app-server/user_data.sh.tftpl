#!/bin/bash
# 최초 부팅 시 1회 실행. 로그: sudo tail -n 100 /var/log/cloud-init-output.log
set -euxo pipefail

# 데이터 볼륨(/data) 마운트: 새 볼륨이면 포맷, 기존 볼륨이면 그대로 붙임
dev=/dev/disk/by-id/nvme-Amazon_Elastic_Block_Store_${data_volume}
for _ in $(seq 60); do [ -e "$dev" ] && break; sleep 5; done
blkid "$dev" || mkfs.xfs "$dev"
echo "UUID=$(blkid -s UUID -o value "$dev") /data xfs defaults,nofail 0 2" >> /etc/fstab
mkdir -p /data && mount -a && mkdir -p /data/pv /data/postgres

# swap 2GB (메모리 2GB에서 JVM + PostgreSQL OOM 방지)
dd if=/dev/zero of=/swapfile bs=1M count=2048 && chmod 600 /swapfile
mkswap /swapfile && swapon /swapfile && echo '/swapfile none swap defaults 0 0' >> /etc/fstab

# Docker + Compose 플러그인 (AL2023 저장소에 compose 플러그인이 없어서 직접 설치)
# 버전 바꿀 때는 https://github.com/docker/compose/releases 에 실제로 있는지 확인
dnf install -y docker && systemctl enable --now docker
mkdir -p /usr/local/lib/docker/cli-plugins
curl -fsSL --retry 5 --retry-all-errors -o /usr/local/lib/docker/cli-plugins/docker-compose \
  "https://github.com/docker/compose/releases/download/v5.6.1/docker-compose-linux-$(uname -m)"
chmod +x /usr/local/lib/docker/cli-plugins/docker-compose

# 배포 시 compose가 읽는 설정
cat > /etc/pv.env <<ENV
AWS_REGION=${region}
REGISTRY=${registry}
OPS_BUCKET=${ops_bucket}
UPLOADS_BUCKET=${uploads_bucket}
SSM_PATH=${ssm_path}
ENV